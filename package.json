{
  "name": "bun-api-server-demo",
  "private": true,
  "type": "module",
  "workspaces": ["api", "web"],
  "scripts": {
    "dev:api": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "dev:docker": "COMPOSE_MENU=0 docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build --watch",
    "dev:docker:down": "COMPOSE_MENU=0 docker-compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker": "COMPOSE_MENU=0 docker-compose up --build",
    "docker:down": "COMPOSE_MENU=0 docker-compose down",
    "test": "vitest run",
    "typecheck": "tsc -p api --noEmit && (cd web && bunx next typegen) && tsc -p web --noEmit",
    "build:lambda": "bun --filter api build:lambda"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
