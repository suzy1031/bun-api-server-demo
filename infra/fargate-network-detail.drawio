                <mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;ブラウザが入る&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;宛先は ALB の公開 DNS。ポートは HTTP の 80。セキュリティグループが自分の IP の /32 だけを通す。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-1-legend" vertex="1">
