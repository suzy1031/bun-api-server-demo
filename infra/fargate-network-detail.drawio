                <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="step-2-legend" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;IGW で VPC に入る&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;インターネットゲートウェイが VPC の出入口。ルートテーブルの 0.0.0.0/0 がここを向いている。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-2-legend" vertex="1">
                    <mxGeometry x="52" width="548" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" parent="legend-container" vertex="1" connectable="0">
                    <mxGeometry y="240" width="600" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="step-3-legend" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;ALB が 1a のタスクへ渡す&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;ALB は 10.20.1.0/24 と 10.20.2.0/24 の両方に足を持つ。転送先は 1a のタスクのプライベート IP、ポート 3000。1c にタスクは無い。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-3-legend" vertex="1">
                    <mxGeometry x="52" width="548" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" parent="legend-container" vertex="1" connectable="0">
                    <mxGeometry y="370" width="600" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="step-4-legend" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;タスクの入口は 3000 だけ&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;タスクのセキュリティグループは、ALB のセキュリティグループから来た TCP 3000 だけを受ける。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-4-legend" vertex="1">
                    <mxGeometry x="52" width="548" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" parent="legend-container" vertex="1" connectable="0">
                    <mxGeometry y="490" width="600" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="step-5-legend" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;API 呼び出しはタスクの中&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Next.js は 127.0.0.1:3002 の Hono を呼ぶ。同じタスクの中なので、VPC のルートも IGW も使わない。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-5-legend" vertex="1">
                    <mxGeometry x="52" width="548" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" parent="legend-container" vertex="1" connectable="0">
                    <mxGeometry y="610" width="600" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="step-6-legend" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;DynamoDB は別経路&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Hono は 10.20.0.2 で名前を引く。返った IP はルートテーブル上でゲートウェイエンドポイントに向く。IGW には出ない。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-6-legend" vertex="1">
                    <mxGeometry x="52" width="548" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" parent="legend-container" vertex="1" connectable="0">
                    <mxGeometry y="750" width="600" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="step-7-legend" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;イメージ取得は IGW 経由&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;点線は起動時。タスクのパブリック IP から 0.0.0.0/0 の経路で IGW を出て、ECR の 443 へ取りにいく。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-7-legend" vertex="1">
                    <mxGeometry x="52" width="548" height="110" as="geometry"/>
                </mxCell>
            </root>
