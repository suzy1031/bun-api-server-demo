# syntax=docker/dockerfile:1

# --- API（開発）---
# Compose の target: api。公式 Bun 1.x
FROM oven/bun:1 AS api
# 作業ディレクトリ（compose.dev の working_dir / Watch の target と揃える）
WORKDIR /app

# 依存定義を先にコピーして、install 層をキャッシュしやすくする
# ルートの workspace 定義と lockfile、各パッケージの package.json が揃って frozen install できる
COPY package.json bun.lock bunfig.toml ./
COPY api/package.json api/package.json
COPY web/package.json web/package.json
# 開発に必要な api とルートの依存を入れる。zod はルートの dependencies。hoisted なので /app/node_modules に揃う
# tarball は BuildKit キャッシュに残す。--prefer-offline でメタデータの再取得を避け、足りないパッケージだけ落とす
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --filter api --filter bun-api-server-demo --linker hoisted --prefer-offline
# bun run dev は api の scripts を読む。workspace ルートの package.json はここで上書きする
COPY api/package.json ./package.json
# 起動時点のソースをイメージに入れておく（以降の変更は Compose Watch が sync）
COPY api/src ./src

# 開発サーバが使うポート（公開は compose の ports）
EXPOSE 3000
# ファイル変更でプロセスを再起動する開発サーバ
CMD ["bun", "run", "dev"]

# --- Web（開発）---
# Compose の target: web
FROM oven/bun:1 AS web
WORKDIR /app

# ルートの workspace 定義と lockfile、各パッケージの package.json が揃って frozen install できる
# typescript はルートの devDependency なので、web に加えてルートパッケージも入れる
COPY package.json bun.lock bunfig.toml ./
COPY api/package.json api/package.json
COPY web/package.json web/package.json
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --filter web --filter bun-api-server-demo --linker hoisted --prefer-offline

# web/ を /app 直下に潰さない。tsconfig は ../tsconfig.base.json を参照し、
# Next の turbopack.root はリポジトリルート（この /app）である必要がある
# web/app は ../../types で共有型を読む
COPY tsconfig.base.json ./tsconfig.base.json
COPY types ./types
COPY web ./web
WORKDIR /app/web
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["bun", "run", "dev"]
