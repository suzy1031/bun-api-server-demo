# 開発用の単一ステージ。公式 Bun 1.x
FROM oven/bun:1
# 作業ディレクトリ（compose.dev の working_dir / Watch の target と揃える）
WORKDIR /app

# 依存定義と Prisma スキーマを先にコピーして、install 層をキャッシュしやすくする
COPY package.json bun.lock prisma.config.ts ./
COPY prisma ./prisma
# 開発に必要な依存を入れ、クライアントを生成する（生成自体は DB 不要）
RUN bun install && DATABASE_URL=postgresql://build:build@localhost:5432/build bunx prisma generate
# 起動時点のソースをイメージに入れておく（以降の変更は Compose Watch が sync）
COPY src ./src

# 開発サーバが使うポート（公開は compose の ports）
EXPOSE 3000
# migrate deploy のあと、ファイル変更でプロセスを再起動する開発サーバ
CMD ["bun", "run", "dev"]
